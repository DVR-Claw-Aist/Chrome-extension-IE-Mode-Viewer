{
  "manifest_version": 3,
  "name": "IE Mode Viewer",
  "version": "1.0.0",
  "description": "Open pages in Internet Explorer (Trident) engine for ActiveX/DVR compatibility",
  "permissions": [
    "nativeMessaging",
    "activeTab",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Open in IE"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content_script.js"],
      "run_at": "document_idle"
    }
  ]
}
